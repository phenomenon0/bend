# Tuples: `tuple[A, B]` is a cons chain Tup<A, Tup<B, Unit>> (the arity is in
# the type), a display is its pairs, `t[i]` is i rests then the first. An
# unpack binds the value to a fresh temporary first and then each name from it,
# so a swap reads both old values, as CPython's does; a `for a, b` target is a
# fresh item unpacked at the top of the step. The expected block is the
# emitted module plus its span map.
import Base
import ../../demos/python/syntax.bend as S
import ../../demos/python/translate.bend as Tr

def show(r: Result<&2, &2, S.Error, String>) -> String:
  match r:
    case Done{s}:
      s
    case Fail{e}:
      S.error_text(e)

def main() -> String:
  show(Tr.translate("def swap(a: str, b: str) -> tuple[str, str]:\n    a, b = b, a\n    return a, b\n\ndef pairs(xs: list[tuple[str, bool]]) -> str:\n    out = \"\"\n    for k, ok in xs:\n        if ok:\n            out = out + k\n    return out\n\ndef use(s: str) -> str:\n    t = swap(s, \"x\")\n    return pairs([(t[1], True), (t[0], False)])\n", Tr.contracts(), ""))
#|"# Faithful translation (tiers 1-2) of Python `swap` 1:0-3:15, `pairs` 5:0-10:14, `use` 12:0-14:47 by demos/python/translate.bend.\nimport Base\n\ntype Tup<-A: Data, -B: Data> is Data:\n  Tup{fst: A, snd: B}\n\ndef Tup.fst(-A: Data, -B: Data, p: Tup<A, B>) -> A:\n  match p:\n    case Tup{a, b}:\n      a\n\ndef Tup.snd(-A: Data, -B: Data, p: Tup<A, B>) -> B:\n  match p:\n    case Tup{a, b}:\n      b\n\ndef swap(a: String, b: String) -> Tup<String, Tup<String, Unit>>:\n  +tup_2_4_2_8 = {Tup{b, Tup{a, Unit{}}} : Tup<String, Tup<String, Unit>>}\n  a = {Tup.fst(String, Tup<String, Unit>, tup_2_4_2_8) : String}\n  b = {Tup.fst(String, Unit, Tup.snd(String, Tup<String, Unit>, tup_2_4_2_8)) : String}\n  Tup{a, Tup{b, Unit{}}}\n\ndef pairs.if_8_8(_c: Bool, k: String, out: String) -> String:\n  match _c:\n    case True{}:\n      out = {String.append(out, k) : String}\n      out\n    case False{}:\n      out\n\ndef pairs.for_7_4(_xs: List<&2, Tup<String, Tup<Bool, Unit>>>, out: String) -> String:\n  match _xs:\n    case Nil{}:\n      out\n    case Con{it_7_4, _rest}:\n      +tup_7_8_7_13 = {it_7_4 : Tup<String, Tup<Bool, Unit>>}\n      k = {Tup.fst(String, Tup<Bool, Unit>, tup_7_8_7_13) : String}\n      ok = {Tup.fst(Bool, Unit, Tup.snd(String, Tup<Bool, Unit>, tup_7_8_7_13)) : Bool}\n      pairs.for_7_4(_rest, pairs.if_8_8(ok, k, out))\n\ndef pairs(xs: List<&2, Tup<String, Tup<Bool, Unit>>>) -> String:\n  out = {\"\" : String}\n  out = {pairs.for_7_4(xs, out) : String}\n  out\n\ndef use(s: String) -> String:\n  +t = {swap(s, \"x\") : Tup<String, Tup<String, Unit>>}\n  pairs([Tup{Tup.fst(String, Unit, Tup.snd(String, Tup<String, Unit>, t)), Tup{True{}, Unit{}}}, Tup{Tup.fst(String, Tup<String, Unit>, t), Tup{False{}, Unit{}}}])\n\n# spans: emitted Bend <- Python source, node : type\n# 17:9-17:18 <- py 1:9-1:15 Param a : String\n# 17:20-17:29 <- py 1:17-1:23 Param b : String\n# 18:2-18:74 <- py 2:4-2:15 Let tup_2_4_2_8 : Tup<String, Tup<String, Unit>>\n# 18:18-18:40 <- py 2:11-2:15 Tuple : Tup<String, Tup<String, Unit>>\n# 18:22-18:23 <- py 2:11-2:12 Var b : String\n# 18:25-18:39 <- py 2:11-2:15 Tuple : Tup<String, Unit>\n# 18:29-18:30 <- py 2:14-2:15 Var a : String\n# 18:32-18:38 <- py 2:11-2:15 Lit Unit{} : Unit\n# 19:2-19:64 <- py 2:4-2:5 Let a : String\n# 19:7-19:54 <- py 2:4-2:5 Item : String\n# 19:42-19:53 <- py 2:4-2:5 Var tup_2_4_2_8 : Tup<String, Tup<String, Unit>>\n# 20:2-20:87 <- py 2:7-2:8 Let b : String\n# 20:7-20:77 <- py 2:7-2:8 Item : String\n# 20:29-20:76 <- py 2:7-2:8 Rest : Tup<String, Unit>\n# 20:64-20:75 <- py 2:7-2:8 Var tup_2_4_2_8 : Tup<String, Tup<String, Unit>>\n# 21:2-21:24 <- py 3:4-3:15 Return : Tup<String, Tup<String, Unit>>\n# 21:2-21:24 <- py 3:11-3:15 Tuple : Tup<String, Tup<String, Unit>>\n# 21:6-21:7 <- py 3:11-3:12 Var a : String\n# 21:9-21:23 <- py 3:11-3:15 Tuple : Tup<String, Unit>\n# 21:13-21:14 <- py 3:14-3:15 Var b : String\n# 21:16-21:22 <- py 3:11-3:15 Lit Unit{} : Unit\n# 26:6-26:44 <- py 9:12-9:25 Let out : String\n# 26:13-26:34 <- py 9:18-9:25 Prim String.append : String\n# 26:27-26:30 <- py 9:18-9:21 Var out : String\n# 26:32-26:33 <- py 9:24-9:25 Var k : String\n# 27:6-27:9 <- py 9:12-9:25 Var out : String\n# 29:6-29:9 <- py 8:8-9:25 Var out : String\n# 36:6-36:61 <- py 7:8-7:13 Let tup_7_8_7_13 : Tup<String, Tup<Bool, Unit>>\n# 36:23-36:29 <- py 7:8-7:13 Var it_7_4 : Tup<String, Tup<Bool, Unit>>\n# 37:6-37:67 <- py 7:8-7:9 Let k : String\n# 37:11-37:57 <- py 7:8-7:9 Item : String\n# 37:44-37:56 <- py 7:8-7:9 Var tup_7_8_7_13 : Tup<String, Tup<Bool, Unit>>\n# 38:6-38:87 <- py 7:11-7:13 Let ok : Bool\n# 38:12-38:79 <- py 7:11-7:13 Item : Bool\n# 38:32-38:78 <- py 7:11-7:13 Rest : Tup<Bool, Unit>\n# 38:65-38:77 <- py 7:11-7:13 Var tup_7_8_7_13 : Tup<String, Tup<Bool, Unit>>\n# 39:27-39:51 <- py 8:8-9:25 Branch if : String\n# 39:40-39:42 <- py 8:11-8:13 Var ok : Bool\n# 41:10-41:52 <- py 5:10-5:36 Param xs : List<&2, Tup<String, Tup<Bool, Unit>>>\n# 42:2-42:21 <- py 6:4-6:12 Let out : String\n# 42:9-42:11 <- py 6:10-6:12 Lit \"\" : String\n# 43:2-43:41 <- py 7:4-9:25 Let out : String\n# 43:9-43:31 <- py 7:4-9:25 Fold it_7_4 -> out : String\n# 43:23-43:25 <- py 7:17-7:19 Var xs : List<&2, Tup<String, Tup<Bool, Unit>>>\n# 43:27-43:30 <- py 7:4-9:25 Var out : String\n# 44:2-44:5 <- py 10:4-10:14 Return : String\n# 44:2-44:5 <- py 10:11-10:14 Var out : String\n# 46:8-46:17 <- py 12:8-12:14 Param s : String\n# 47:2-47:54 <- py 13:4-13:20 Let t : Tup<String, Tup<String, Unit>>\n# 47:8-47:20 <- py 13:8-13:20 Call swap : Tup<String, Tup<String, Unit>>\n# 47:13-47:14 <- py 13:13-13:14 Var s : String\n# 47:16-47:19 <- py 13:16-13:19 Lit \"x\" : String\n# 48:2-48:163 <- py 14:4-14:47 Return : String\n# 48:2-48:163 <- py 14:11-14:47 Call pairs : String\n# 48:8-48:162 <- py 14:17-14:46 List : List<&2, Tup<String, Tup<Bool, Unit>>>\n# 48:9-48:95 <- py 14:18-14:30 Tuple : Tup<String, Tup<Bool, Unit>>\n# 48:13-48:73 <- py 14:19-14:23 Item : String\n# 48:35-48:72 <- py 14:19-14:23 Rest : Tup<String, Unit>\n# 48:70-48:71 <- py 14:19-14:20 Var t : Tup<String, Tup<String, Unit>>\n# 48:75-48:94 <- py 14:18-14:30 Tuple : Tup<Bool, Unit>\n# 48:79-48:85 <- py 14:25-14:29 Lit True{} : Bool\n# 48:87-48:93 <- py 14:18-14:30 Lit Unit{} : Unit\n# 48:97-48:161 <- py 14:32-14:45 Tuple : Tup<String, Tup<Bool, Unit>>\n# 48:101-48:138 <- py 14:33-14:37 Item : String\n# 48:136-48:137 <- py 14:33-14:34 Var t : Tup<String, Tup<String, Unit>>\n# 48:140-48:160 <- py 14:32-14:45 Tuple : Tup<Bool, Unit>\n# 48:144-48:151 <- py 14:39-14:44 Lit False{} : Bool\n# 48:153-48:159 <- py 14:32-14:45 Lit Unit{} : Unit\n"
