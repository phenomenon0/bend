   fmt(String.format("{+1}", ["a", "b"])),
   fmt(String.format("x={}, y={}!", ["1", "2"])),
   fmt(String.format("}}{{", [])),
   fmt(String.format("{99999999999999999999999999}", ["a"])),
   preds("\u{e9}"),
