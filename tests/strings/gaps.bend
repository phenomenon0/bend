   String.center("abc", 6n, ' '),
   String.center("abc", 2n, '.'),
   String.center("", 3n, '.'),
   String.center("ab", 2n, '.'),
   String.center("a", 2n, '.'),
   String.center("ab", 3n, '.'),
   String.center("", 0n, '.'),
   String.swapcase(""),
   String.title(""),
