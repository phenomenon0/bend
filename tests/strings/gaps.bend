   preds("\u{663}"),
   String.title("\u{e9}a"),
   String.swapcase("\u{df}"),
   bars(String.rsplit("abc", "")),
   tri(String.rpartition("abc", "")),
   fmt(String.format("{:>5}", ["a"])),
   fmt(String.format("{0!r}", ["a"]))]

